# Soak new releases before installing: a package published hours ago is the
# shape a compromised-maintainer attack takes. Needs npm >= 11; older npm
# ignores this setting silently, hence the engines constraint.
min-release-age=7
# Our own cashu-ts experimental builds are pinned deliberately and are newer
# than the window by design; their dependencies still obey it.
min-release-age-exclude[]=@cashu/cashu-ts
